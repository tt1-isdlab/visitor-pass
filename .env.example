# ── Database (Supabase Postgres) ─────────────────────────────────────────
# From Supabase Dashboard → Project Settings → Database → Connection string.
# Use the "Transaction pooler" (port 6543) URL for DATABASE_URL (serverless-friendly)
# and the direct connection (port 5432) for DIRECT_URL (used by `prisma migrate`).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres"

# ── Supabase Storage ──────────────────────────────────────────────────────
# From Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-here" # server-only, never expose to the client
STORAGE_BUCKET="authorization-letters"

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Payment ───────────────────────────────────────────────────────────────
# Visitors are redirected here immediately after a successful registration submit.
NEXT_PUBLIC_PAYMENT_LINK_URL="https://rzp.io/rzp/rfvisitingpass"

# ── Seed script (initial SUPER_ADMIN) ────────────────────────────────────
SEED_ADMIN_EMAIL="admin@robofest.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="RoboFest Super Admin"

# ── Email (optional — currently emails are queued/stored in email_logs) ──
# Wire up a provider later in src/lib/email.ts. Suggested env vars:
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=
